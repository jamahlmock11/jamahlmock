KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PEM=
# Or path to PEM file:
# KALSHI_PRIVATE_KEY_PATH=./secrets/kalshi.key
# public | demo | prod
KALSHI_ENV=public
# Optional licensed CF Benchmarks API (https://docs.cfbenchmarks.com/api/)
CF_BENCHMARKS_API_USERNAME=
CF_BENCHMARKS_API_KEY=
CONFIG_PATH=config/default.yaml
LOG_LEVEL=INFO
