PAPER_MODE=false
BANKROLL_USD=1
MAX_TRADE_USD=1
MAX_BANKROLL_PCT=1.0
KALSHI_ENV=prod
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PEM=
# Or path to PEM file:
# KALSHI_PRIVATE_KEY_PATH=./secrets/kalshi.key
# Optional licensed CF Benchmarks API (https://docs.cfbenchmarks.com/api/)
CF_BENCHMARKS_API_USERNAME=
CF_BENCHMARKS_API_KEY=
LOG_LEVEL=INFO

# SMS alerts (Twilio) — https://www.twilio.com/console
NOTIFY_ENABLED=false
NOTIFY_PHONE_NUMBER=+15551234567
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15559876543
NOTIFY_ON_TRADE=true
NOTIFY_ON_SETTLEMENT=true
NOTIFY_ON_ORDER_FAILED=true
NOTIFY_ON_PAPER=false
NOTIFY_ON_STARTUP=false
TWILIO_TRIAL_TEMPLATE=sms_appointment_reminders

# Take-profit / stop-loss (sell at bid before settlement)
EXIT_ENABLED=true
TAKE_PROFIT_PCT=0.50
STOP_LOSS_PCT=0.40
EXIT_MIN_HOLD_SECONDS=0
NOTIFY_ON_EXIT=true

# Trend-following gates (keep edge + evidence + card + risk rules)
TREND_GATE_ENABLED=true
FLOW_CONFIRM_ENABLED=false
TREND_MIN_MOMENTUM=0
TREND_REQUIRE_SPOT_VS_STRIKE=false
TREND_BIAS_SELECTION=true
DAILY_LOSS_STOP_PCT=0.12

# Late crowd favorite — conviction entry in final minutes if hour slot unused
LATE_CROWD_ENABLED=true
LATE_CROWD_MAX_SECONDS=600

# Kalshi Pro — real-time depth + order flow on dashboard
KALSHI_PRO_ENABLED=true
KALSHI_PRO_DEPTH=10
KALSHI_PRO_FLOW_WINDOW=120
